*.egg-info/
dist/
build/
.pytest_cache/
__pycache__/
*.pyc
.DS_Store
.env
.env.local
.env.*.local
.ruff_cache/
.venv/
.codex/

# Tests
**/route-knowledge.json

# Token tracking session data
.claude/.token-stats/

# ClosedLoop session-level artifacts (cleaned up by SessionEnd hook)
.claude/closedloop-loop.local.md
.closedloop/
.agent-types/
.claude/closedloop-progress.log

# Runs directory (implementation plans, staged plans, etc.)
.claude/runs/*
.claude/work/*
**/.claude/cache/

# ClosedLoop plugin workspace (code review ephemeral data, etc.)
# Ignore everything under .closedloop-ai/ EXCEPT the bootstrap plugin's
# durable outputs (per plugins/bootstrap/README.md):
#   - bootstrap-metadata.json  (tracks generated agents for --update mode)
#   - settings/critic-gates.json  (critic selection rules for /code workflows)
.closedloop-ai/*
!.closedloop-ai/bootstrap-metadata.json
!.closedloop-ai/settings/

# Generated route knowledge files
.claude/docs/routes/*
