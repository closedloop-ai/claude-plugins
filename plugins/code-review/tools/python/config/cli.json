{
  "parsers": [
    {
      "name": "parse-diff",
      "help": "Parse git diff into structured JSON",
      "func": "cmd_parse_diff",
      "args": [
        {
          "flags": [
            "--scope"
          ],
          "required": true,
          "help": "Git diff scope (e.g. \"main...HEAD\", \"--cached\")"
        },
        {
          "flags": [
            "--workdir"
          ],
          "help": "Git working directory"
        }
      ]
    },
    {
      "name": "hygiene",
      "help": "Run deterministic hygiene checks",
      "func": "cmd_hygiene",
      "args": [
        {
          "flags": [
            "--diff-data"
          ],
          "help": "Path to diff_data.json (reads stdin if omitted)"
        },
        {
          "flags": [
            "--workdir"
          ],
          "help": "Git working directory for check-ignore"
        },
        {
          "flags": [
            "--depth"
          ],
          "choices": [
            "shallow",
            "standard",
            "deep"
          ],
          "help": "Invocation tier; shallow emits a tier-mismatch nudge when LOC/schema/public-API heuristics suggest standard or deep would have caught more"
        }
      ]
    },
    {
      "name": "partition",
      "help": "Bin-pack files into partitions",
      "func": "cmd_partition",
      "args": [
        {
          "flags": [
            "--diff-data"
          ],
          "help": "Path to diff_data.json (reads stdin if omitted)"
        },
        {
          "flags": [
            "--loc-budget"
          ],
          "default": 400,
          "type": "int",
          "help": "LOC budget per partition"
        },
        {
          "flags": [
            "--max-files"
          ],
          "default": 20,
          "type": "int",
          "help": "Max files per partition"
        },
        {
          "flags": [
            "--max-bha-agents"
          ],
          "default": "$$DEFAULT_MAX_BHA_AGENTS",
          "type": "int",
          "help": "Max BHA agent partitions (cap enforcement)"
        },
        {
          "flags": [
            "--diff-scope"
          ],
          "help": "Git diff scope for per-partition patch generation"
        },
        {
          "flags": [
            "--cr-dir"
          ],
          "help": "Directory to write patches_p<N>.txt into"
        },
        {
          "flags": [
            "--workdir"
          ],
          "help": "Git working directory"
        }
      ]
    },
    {
      "name": "route",
      "help": "Compute risk scores and model routing",
      "func": "cmd_route",
      "args": [
        {
          "flags": [
            "--diff-data"
          ],
          "help": "Path to diff_data.json (reads stdin if omitted)"
        },
        {
          "flags": [
            "--critic-gates"
          ],
          "help": "Path to critic-gates.json"
        },
        {
          "flags": [
            "--intent"
          ],
          "default": "mixed",
          "choices": [
            "feature",
            "fix",
            "refactor",
            "mixed"
          ],
          "help": "PR intent classification (from classify-intent)"
        },
        {
          "flags": [
            "--cr-dir"
          ],
          "help": "CR session directory; when set, writes spawn.json.route via atomic section update. Without it, the routing block is only emitted to stdout (legacy mode)."
        }
      ]
    },
    {
      "name": "validate",
      "help": "Normalize, filter, and deduplicate findings",
      "func": "cmd_validate",
      "args": [
        {
          "flags": [
            "--findings"
          ],
          "required": true,
          "help": "Path to findings JSON file"
        },
        {
          "flags": [
            "--diff-data"
          ],
          "required": true,
          "help": "Path to diff data JSON file"
        },
        {
          "flags": [
            "--settings"
          ],
          "help": "Path to code-review.json (operator-tunable settings; defaults to .closedloop-ai/settings/code-review.json). Used to load out_of_hunk_confidence_floor."
        }
      ]
    },
    {
      "name": "verify-prepare",
      "help": "Tier-select findings for verification and emit per-finding inputs",
      "func": "cmd_verify_prepare",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--findings"
          ],
          "required": true,
          "help": "Path to findings_validated.json (or any {validated|findings: [...]} JSON)"
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "help": "Optional cache directory; when set, fresh (finding_id, snippet_hash, model, prompt_hash) tuples are served from the verifications/ namespace."
        },
        {
          "flags": [
            "--prompt-hash"
          ],
          "default": "",
          "help": "Verifier prompt hash; part of the cache key so prompt revs invalidate cache."
        }
      ]
    },
    {
      "name": "verify-consolidate",
      "help": "Merge verifier outputs with validated set + bucket-split (verified/rejected/pending)",
      "func": "cmd_verify_consolidate",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--validated"
          ],
          "required": true,
          "help": "Path to findings_validated.json"
        },
        {
          "flags": [
            "--manifest"
          ],
          "help": "Path to verify_manifest.json (defaults to <cr-dir>/verify_manifest.json)"
        },
        {
          "flags": [
            "--gates"
          ],
          "help": "Path to verification-gates.json (defaults to .closedloop-ai/settings/verification-gates.json)"
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "help": "Optional cache directory; fresh verifier outputs are written back here."
        },
        {
          "flags": [
            "--prompt-hash"
          ],
          "default": "",
          "help": "Verifier prompt hash for cache write-back keys."
        }
      ]
    },
    {
      "name": "extract-signals-prepare",
      "help": "Prepare signal-extraction agent input; serve from signals/ cache on hit.",
      "func": "cmd_extract_signals_prepare",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--diff-data"
          ],
          "required": true,
          "help": "Path to diff_data.json"
        },
        {
          "flags": [
            "--diff-tip"
          ],
          "required": true,
          "help": "Diff tip SHA for cache key"
        },
        {
          "flags": [
            "--prompt-hash"
          ],
          "default": "",
          "help": "Canonical prompt hash for the signals/ namespace cache key."
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "help": "Optional cache directory; fresh (diff_tip, taxonomy_hash, prompt_hash) tuples are served from the signals/ namespace."
        },
        {
          "flags": [
            "--taxonomy"
          ],
          "help": "Path to signal_taxonomy.json (defaults to module-relative asset)."
        },
        {
          "flags": [
            "--prompt"
          ],
          "help": "Path to signal_extraction_prompt.txt (defaults to module-relative asset)."
        },
        {
          "flags": [
            "--intent"
          ],
          "help": "Optional intent context JSON (treated as untrusted hint in the agent input)."
        },
        {
          "flags": [
            "--model"
          ],
          "default": "$$SIGNAL_EXTRACTION_MODEL_DEFAULT",
          "help": "Model label recorded in the manifest (the orchestrator picks the actual agent)."
        }
      ]
    },
    {
      "name": "extract-signals-consolidate",
      "help": "Validate agent signal output; write extract_signals.json + cache on success.",
      "func": "cmd_extract_signals_consolidate",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--agent-output"
          ],
          "required": true,
          "help": "Path to the agent's signal-extraction output JSON."
        },
        {
          "flags": [
            "--manifest"
          ],
          "help": "Path to extract_signals_manifest.json (defaults to <cr-dir>/extract_signals_manifest.json)."
        },
        {
          "flags": [
            "--taxonomy"
          ],
          "help": "Path to signal_taxonomy.json (defaults to module-relative asset)."
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "help": "Optional cache directory; successful extractions write back to signals/."
        }
      ]
    },
    {
      "name": "resolve-coverage",
      "help": "Deterministic resolver: critic-gates + diff + signals -> coverage.json.initial (Phase C, v2.27.0; pre-v2.27.0 wrote a standalone coverage_plan_initial.json)",
      "func": "cmd_resolve_coverage",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--diff-data"
          ],
          "required": true,
          "help": "Path to diff_data.json"
        },
        {
          "flags": [
            "--critic-gates"
          ],
          "help": "Path to critic-gates.json (defaults to empty manifest when absent)"
        },
        {
          "flags": [
            "--extract-signals"
          ],
          "help": "Path to extract_signals.json (optional; absent \u2192 signal triggers cannot fire)"
        },
        {
          "flags": [
            "--scope"
          ],
          "default": "code-review",
          "choices": "$$COVERAGE_SCOPES_SORTED",
          "help": "Rule scope filter (default: code-review)"
        },
        {
          "flags": [
            "--depth"
          ],
          "choices": ["shallow", "standard", "deep"],
          "help": "Invocation tier (FEA-1401). Gates COVERAGE_CORE_CONDITIONAL reviewers like the Impact Analyzer."
        }
      ]
    },
    {
      "name": "load-available-reviewers",
      "help": "Scan .claude/agents/*.md -> available_reviewers.json (the AVAILABLE roster the critic enforces against)",
      "func": "cmd_load_available_reviewers",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--agents-dir"
          ],
          "help": "Directory of *.md agent definitions (default: .claude/agents)"
        }
      ]
    },
    {
      "name": "coverage-critic-prepare",
      "help": "Prepare coverage-critic agent input; serve from coverage_critic/ cache on hit. Reads initial plan from coverage.json.initial; writes critic manifest to coverage.json.critic and (on cache_hit/skipped) the final plan to coverage.json.final.",
      "func": "cmd_coverage_critic_prepare",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--diff-data"
          ],
          "required": true,
          "help": "Path to diff_data.json"
        },
        {
          "flags": [
            "--available-reviewers"
          ],
          "required": true,
          "help": "Path to a JSON file containing the AVAILABLE list (flat list or {available: [...]})"
        },
        {
          "flags": [
            "--extract-signals"
          ],
          "help": "Path to extract_signals.json (optional but recommended)"
        },
        {
          "flags": [
            "--diff-tip"
          ],
          "required": true,
          "help": "Diff tip SHA for cache key"
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "help": "Optional cache directory; fresh tuples served from coverage_critic/"
        },
        {
          "flags": [
            "--prompt"
          ],
          "help": "Path to coverage_critic_prompt.txt (defaults to module-relative asset)"
        },
        {
          "flags": [
            "--model"
          ],
          "default": "$$COVERAGE_CRITIC_MODEL_DEFAULT",
          "help": "Model label recorded in the manifest"
        },
        {
          "flags": [
            "--no-critic"
          ],
          "action": "store_true",
          "help": "Skip the LLM critic entirely; copy the initial plan straight through into coverage.json.final with critic_status=\"skipped\"."
        }
      ]
    },
    {
      "name": "coverage-critic-consolidate",
      "help": "Validate agent critic output; merge into coverage.json.final + cache.",
      "func": "cmd_coverage_critic_consolidate",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--agent-output"
          ],
          "required": true,
          "help": "Path to the agent's coverage-critic output JSON"
        },
        {
          "flags": [
            "--available-reviewers"
          ],
          "required": true,
          "help": "Path to the AVAILABLE list (same file used by --prepare)"
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "help": "Optional cache directory; successful runs write back to coverage_critic/"
        }
      ]
    },
    {
      "name": "verify-coverage",
      "help": "Deterministic verifier for coverage.json.final. Writes verdict PASS|BLOCKING and per-check violations to coverage.json.verify; emits a HIGH system finding on BLOCKING.",
      "func": "cmd_verify_coverage",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--available-reviewers"
          ],
          "help": "Path to available_reviewers.json (roster). Closed-vocabulary check is bypassed when the file is missing or empty."
        }
      ]
    },
    {
      "name": "re-assert",
      "help": "Write operator override files for one or more finding IDs",
      "func": "cmd_re_assert",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "required": true,
          "help": "Cache directory where overrides/<finding_id>.json files are written."
        },
        {
          "flags": [
            "--finding-ids"
          ],
          "required": true,
          "help": "Comma-separated list of finding IDs to re-assert."
        },
        {
          "flags": [
            "--prior-result"
          ],
          "help": "Path to prior review_result.json. Defaults to <CR_DIR>/review_result.json."
        },
        {
          "flags": [
            "--reason"
          ],
          "default": "",
          "help": "Optional operator-supplied reason for the re-assertion; recorded in the override file and pending-learnings."
        },
        {
          "flags": [
            "--asserted-by"
          ],
          "default": "operator",
          "help": "Identifier of the operator (defaults to 'operator')."
        }
      ]
    },
    {
      "name": "review-dismissed-prepare",
      "help": "Build a haiku-verifier manifest from prior rejected[] for second-opinion run.",
      "func": "cmd_review_dismissed_prepare",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--prior-result"
          ],
          "help": "Path to prior review_result.json. Defaults to <CR_DIR>/review_result.json."
        }
      ]
    },
    {
      "name": "review-dismissed-consolidate",
      "help": "Read haiku verifier outputs; auto-promote non-REJECTED verdicts via overrides.",
      "func": "cmd_review_dismissed_consolidate",
      "args": [
        {
          "flags": [
            "--cr-dir"
          ],
          "required": true,
          "help": "CR_DIR path"
        },
        {
          "flags": [
            "--cache-dir"
          ],
          "required": true,
          "help": "Cache directory; auto-promotions write overrides/<finding_id>.json."
        },
        {
          "flags": [
            "--manifest"
          ],
          "help": "Path to review_dismissed_manifest.json (defaults to <CR_DIR>/review_dismissed_manifest.json)."
        }
      ]
    },
    {
      "name": "cache-check",
      "help": "Check BHA cache for previously reviewed files",
      "func": "cmd_cache_check",
      "args": [
        {
          "flags": [
            "--cache-dir"
          ],
          "required": true,
          "help": "Path to cache directory"
        },
        {
          "flags": [
            "--diff-data"
          ],
          "required": true,
          "help": "Path to diff_data.json"
        },
        {
          "flags": [
            "--prompt-hash"
          ],
          "required": true,
          "help": "SHA256 of shared prompt"
        },
        {
          "flags": [
            "--model-id"
          ],
          "required": true,
          "help": "Model identifier (e.g. opus)"
        },
        {
          "flags": [
            "--schema-version"
          ],
          "required": true,
          "type": "int",
          "help": "Cache schema version"
        },
        {
          "flags": [
            "--output-dir"
          ],
          "required": true,
          "help": "Directory for output files"
        },
        {
          "flags": [
            "--global-cache"
          ],
          "default": 0,
          "type": "int",
          "help": "Enable global V2 cache (0 or 1)"
        },
        {
          "flags": [
            "--context-key"
          ],
          "default": "",
          "help": "Context key (merge-base SHA)"
        }
      ]
    },
    {
      "name": "cache-update",
      "help": "Update BHA cache with new findings",
      "func": "cmd_cache_update",
      "args": [
        {
          "flags": [
            "--cache-dir"
          ],
          "required": true,
          "help": "Path to cache directory"
        },
        {
          "flags": [
            "--diff-data"
          ],
          "required": true,
          "help": "Path to diff_data.json"
        },
        {
          "flags": [
            "--bha-dir"
          ],
          "required": true,
          "help": "Directory containing agent_bha_*.json files"
        },
        {
          "flags": [
            "--prompt-hash"
          ],
          "required": true,
          "help": "SHA256 of shared prompt"
        },
        {
          "flags": [
            "--model-id"
          ],
          "required": true,
          "help": "Model identifier (e.g. opus)"
        },
        {
          "flags": [
            "--schema-version"
          ],
          "required": true,
          "type": "int",
          "help": "Cache schema version"
        },
        {
          "flags": [
            "--reviewed-files"
          ],
          "default": [],
          "nargs": "*",
          "help": "Files that were reviewed"
        },
        {
          "flags": [
            "--partitions-file"
          ],
          "help": "Path to partitions JSON (extracts reviewed files)"
        },
        {
          "flags": [
            "--global-cache"
          ],
          "default": 0,
          "type": "int",
          "help": "Enable global V2 cache (0 or 1)"
        },
        {
          "flags": [
            "--context-key"
          ],
          "default": "",
          "help": "Context key (merge-base SHA)"
        },
        {
          "flags": [
            "--gc-ttl-days"
          ],
          "default": "$$CACHE_GC_TTL_DAYS_DEFAULT",
          "type": "int",
          "help": "GC TTL in days"
        },
        {
          "flags": [
            "--gc-max-per-file"
          ],
          "default": "$$CACHE_GC_MAX_PER_FILE_DEFAULT",
          "type": "int",
          "help": "Max cache entries per file"
        },
        {
          "flags": [
            "--exclude-test-partitions"
          ],
          "action": "store_true",
          "help": "Skip caching files from is_test_only partitions"
        }
      ]
    },
    {
      "name": "post-comments",
      "help": "Post inline review comments to GitHub PR",
      "func": "cmd_post_comments",
      "args": [
        {
          "flags": [
            "--findings"
          ],
          "required": true,
          "help": "Path to code-review-findings.json"
        },
        {
          "flags": [
            "--repo"
          ],
          "help": "owner/repo (defaults to GITHUB_REPOSITORY env)"
        },
        {
          "flags": [
            "--dry-run"
          ],
          "action": "store_true",
          "help": "Print actions without executing"
        }
      ]
    },
    {
      "name": "resolve-threads",
      "help": "Resolve outdated review threads on GitHub PR",
      "func": "cmd_resolve_threads",
      "args": [
        {
          "flags": [
            "--threads"
          ],
          "required": true,
          "help": "Path to code-review-threads.json"
        },
        {
          "flags": [
            "--dry-run"
          ],
          "action": "store_true",
          "help": "Print actions without executing"
        }
      ]
    },
    {
      "name": "review-state-read",
      "help": "Read review state for a branch:base key",
      "func": "cmd_review_state_read",
      "args": [
        {
          "flags": [
            "--cache-dir"
          ],
          "required": true,
          "help": "Path to cache directory"
        },
        {
          "flags": [
            "--key"
          ],
          "required": true,
          "help": "State key (branch:base_ref)"
        },
        {
          "flags": [
            "--depth"
          ],
          "choices": [
            "shallow",
            "standard",
            "deep"
          ],
          "help": "New invocation tier; a cached entry weaker than this returns {} (cache miss)"
        }
      ]
    },
    {
      "name": "review-state-write",
      "help": "Write review state entry",
      "func": "cmd_review_state_write",
      "args": [
        {
          "flags": [
            "--cache-dir"
          ],
          "required": true,
          "help": "Path to cache directory"
        },
        {
          "flags": [
            "--key"
          ],
          "required": true,
          "help": "State key (branch:base_ref)"
        },
        {
          "flags": [
            "--sha"
          ],
          "help": "HEAD SHA at time of review"
        },
        {
          "flags": [
            "--ref"
          ],
          "help": "Git ref to resolve to SHA (alternative to --sha)"
        },
        {
          "flags": [
            "--depth"
          ],
          "choices": [
            "shallow",
            "standard",
            "deep"
          ],
          "help": "Tier this review ran at (persisted so future runs can detect tier transitions)"
        }
      ]
    },
    {
      "name": "session-tokens",
      "help": "Sum token usage from session transcript",
      "func": "cmd_session_tokens",
      "args": [
        {
          "flags": [
            "--project-dir"
          ],
          "help": "Project directory (defaults to cwd)"
        },
        {
          "flags": [
            "--start-time"
          ],
          "required": true,
          "type": "float",
          "help": "Epoch seconds when review started"
        }
      ]
    },
    {
      "name": "setup",
      "help": "Session setup: start_time, repo_name, current_branch, global_cache",
      "func": "cmd_setup",
      "args": [
        {
          "flags": [
            "--mode"
          ],
          "required": true,
          "choices": [
            "local",
            "github"
          ],
          "help": "Review mode"
        },
        {
          "flags": [
            "--cr-dir-prefix"
          ],
          "help": "CR dir prefix (e.g. .closedloop-ai/code-review/cr-); random suffix appended"
        }
      ]
    },
    {
      "name": "resolve-scope",
      "help": "Resolve diff scope from arguments",
      "func": "cmd_resolve_scope",
      "args": [
        {
          "flags": [
            "--mode"
          ],
          "required": true,
          "choices": [
            "local",
            "github"
          ]
        },
        {
          "flags": [
            "--pr-number"
          ],
          "type": "int"
        },
        {
          "flags": [
            "--scope-args"
          ],
          "default": "",
