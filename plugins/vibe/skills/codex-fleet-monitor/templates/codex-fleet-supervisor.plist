<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the codex-fleet-monitor supervisor. Replace SKILL_DIR (the codex-fleet-monitor
  skill directory) and WORK_DIR (the supervisor's work dir), save it as
  ~/Library/LaunchAgents/codex-fleet-supervisor.plist, then run
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/codex-fleet-supervisor.plist
  To restart it, run launchctl bootout gui/$(id -u)/codex-fleet-supervisor, then the same
  launchctl bootstrap line. Never use launchctl kickstart -k, which hung the calling shell and left
  the job waiting ThrottleInterval before it respawned.
  The login shell puts node and codex on PATH. launchd appends to supervisor.log, and the supervisor
  rotates it at LOG_MAX_BYTES (default 1 MB) into supervisor.log.1.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>codex-fleet-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "SKILL_DIR/scripts/supervise.sh" "WORK_DIR"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>WORK_DIR/supervisor.log</string>
  <key>StandardErrorPath</key>
  <string>WORK_DIR/supervisor.log</string>
</dict>
</plist>
